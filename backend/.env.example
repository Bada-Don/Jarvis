# Backend Environment Variables
# Copy this file to .env and fill in your values

# Gemini API Key for the Planner Model (Gemini Flash Lite)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=sk-proj.....

# Local LLM Provider (LM Studio / Ollama)
# Set LLM_PROVIDER=local to use a local model instead of cloud APIs
LLM_PROVIDER=gemini
LOCAL_MODEL_NAME=google/gemma-4-e2b
LOCAL_BASE_URL=http://127.0.0.1:1234/v1

# Firebase Configuration (for desktop-to-mobile communication)
# Path to Firebase Admin SDK credentials JSON file
FIREBASE_CREDENTIALS_PATH=../data/firebase-admin-credentials.json

# Firebase Realtime Database URL
# Format: https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
