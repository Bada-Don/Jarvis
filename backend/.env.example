# Backend Environment Variables
# Copy this file to .env and fill in your values

# Planner Model Configuration
# NOTE: USE_LOCAL_MODEL is now configured in local_client/config.py
# Set config.USE_LOCAL_MODEL = True to use local FunctionGemma (saves API costs)
# Set config.USE_LOCAL_MODEL = False to use Gemini API (requires GEMINI_API_KEY below)

# Gemini API Key for the Planner Model (only needed if USE_LOCAL_MODEL=False in config.py)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
