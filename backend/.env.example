# Backend Environment Variables
# Copy this file to .env and fill in your values

# ==================== LLM Provider Configuration ====================
# Choose one: gemini, openai, or aws_bedrock
LLM_PROVIDER=aws_bedrock

# Gemini API Key (if using Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (if using OpenAI)
OPENAI_API_KEY=sk-proj.....

# ==================== System Configuration ====================
# Windows username for path generation (leave empty to auto-detect)
WINDOWS_USERNAME=

# User-specific paths (leave empty to auto-generate based on username)
DESKTOP_PATH=
DOCUMENTS_PATH=
DOWNLOADS_PATH=
STICKERS_PATH=D:\Stickers\New Briefcase

# ==================== AWS Configuration ====================
# AWS Credentials (for Bedrock, DynamoDB, S3)
# Option 1: Use environment variables
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Option 2: Use AWS CLI config (~/.aws/credentials)
# Option 3: Use IAM Role (if running on EC2)

# AWS Bedrock Configuration
AWS_BEDROCK_PLANNER_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
AWS_BEDROCK_VISION_MODEL=us.anthropic.claude-sonnet-4-6

# AWS DynamoDB Configuration
AWS_DYNAMODB_TABLE_NAME=JarvisState

# AWS S3 Configuration
AWS_S3_BUCKET_NAME=jarvis-automation-assets

# ==================== Firebase Configuration (Legacy) ====================
# Path to Firebase Admin SDK credentials JSON file
FIREBASE_CREDENTIALS_PATH=../data/firebase-admin-credentials.json

# Firebase Realtime Database URL
# Format: https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Enable/Disable Firebase (set to false to use AWS only)
FIREBASE_ENABLED=false

# ==================== Email Configuration ====================
EMAIL_SENDER_ADDRESS=your_email@gmail.com
EMAIL_APP_PASSWORD=your_app_password_here

# ==================== Browser Automation Configuration ====================
# Path to the browser executable (e.g. C:\Program Files\Google\Chrome\Application\chrome.exe)
BROWSER_PATH=

# Path to the browser user data directory (e.g. %LOCALAPPDATA%\Google\Chrome\User Data)
# Leave empty for a clean profile, or provide path for persistent sessions.
BROWSER_USER_DATA=
