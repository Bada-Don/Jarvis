{
  "rules": {
    "devices": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "pairing": {
      "$token": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "messages": {
      "$deviceId": {
        ".read": "auth != null",
        ".write": "auth != null",
        "commands": {
          "$messageId": {
            ".validate": "newData.hasChildren(['type', 'text', 'timestamp', 'processed'])"
          }
        },
        "status": {
          "$messageId": {
            ".validate": "newData.hasChildren(['type', 'message', 'timestamp'])"
          }
        }
      }
    },
    "rateLimiting": {
      "$userId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}