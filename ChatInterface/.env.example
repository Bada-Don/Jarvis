# Mobile App Environment Variables
# Copy this file to .env and fill in your values

# Backend Server URL (for local development)
# Use your computer's local IP address when testing on physical device
# Example: http://192.168.1.100:5000
BACKEND_URL=http://localhost:5000

# Firebase Configuration (for desktop-to-mobile communication)
# Firebase Realtime Database URL
# Format: https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/

# Firebase Project ID
FIREBASE_PROJECT_ID=your-project-id

# Note: Firebase client configuration (google-services.json for Android and 
# GoogleService-Info.plist for iOS) should be placed in their respective 
# platform directories as per Firebase setup instructions.
