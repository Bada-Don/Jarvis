# Local Client Environment Variables
# Copy this file to .env and fill in your values

# Backend Server URL
# Set this to your backend server address (default: http://localhost:5000)
# For remote backend: http://YOUR_SERVER_IP:5000
BACKEND_URL=http://localhost:5000

# Gemini API Key for the Vision Mapper Model (Gemini 2.0 Flash)
# Get your API key from: https://makersuite.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Configuration (for desktop-to-mobile communication)
# Enable/Disable Firebase (set to false to use AWS only)
FIREBASE_ENABLED=false

# Path to Firebase Admin SDK credentials JSON file
FIREBASE_CREDENTIALS_PATH=../data/firebase-admin-credentials.json

# Firebase Realtime Database URL
# Format: https://YOUR-PROJECT-ID-default-rtdb.firebaseio.com/
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com/
