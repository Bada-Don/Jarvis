{
  "sequence": [
    {
      "order": 1,
      "type": "keyboard",
      "value": "win+r",
      "desc": "Open Run dialog"
    },
    {
      "order": 2,
      "type": "keyboard",
      "value": "cmd",
      "desc": "Open Command Prompt"
    },
    {
      "order": 3,
      "type": "keyboard",
      "value": "enter",
      "desc": "Launch Command Prompt"
    },
    {
      "order": 4,
      "type": "keyboard",
      "value": "cd /d \"%USERPROFILE%\\OneDrive\\Desktop\"",
      "desc": "Change directory to Desktop"
    },
    {
      "order": 5,
      "type": "keyboard",
      "value": "enter",
      "desc": "Run cd command"
    },
    {
      "order": 6,
      "type": "keyboard",
      "value": "if exist \"NewFolder\" rmdir /s /q \"NewFolder\"",
      "desc": "Delete NewFolder from Desktop if it exists"
    },
    {
      "order": 7,
      "type": "keyboard",
      "value": "enter",
      "desc": "Execute delete command"
    },
    {
      "order": 8,
      "type": "keyboard",
      "value": "mkdir \"Practicals\"",
      "desc": "Create Practicals folder on Desktop"
    },
    {
      "order": 9,
      "type": "keyboard",
      "value": "enter",
      "desc": "Execute mkdir command"
    },
    {
      "order": 10,
      "type": "keyboard",
      "value": "cd \"Practicals\"",
      "desc": "Enter Practicals folder"
    },
    {
      "order": 11,
      "type": "keyboard",
      "value": "enter",
      "desc": "Run cd command"
    },
    {
      "order": 12,
      "type": "keyboard",
      "value": "type nul > p1.doc && type nul > p2.doc && type nul > p3.doc",
      "desc": "Create three .doc files named p1, p2, p3"
    },
    {
      "order": 13,
      "type": "keyboard",
      "value": "enter",
      "desc": "Execute file creation command"
    }
  ],
  "expected_final_state": "NewFolder is removed from the Desktop (if it existed). A folder named Practicals exists on the Desktop containing three files: p1.doc, p2.doc, and p3.doc.",
  "mode": "general"
}