{
  "loader_patcher": {
    "process_name": "Your FlexiSign Process Name.exe",
    "exe_path": "C:\\Path\\To\\FlexiSign.exe",
    "startup_modal": {
      "enabled": true,
      "title": "FlexiSign Startup Modal Title",
      "button": "OK",
      "timeout": 15
    },
    "wait_after_start": 20
  },
  "flexisign_pro": {
    "process_names": ["Flexi"],
    "exe_path": "C:\\Program Files (x86)\\SAi\\SAi Production Suite\\Program\\app.exe",
    "window_titles": ["FlexiSIGN-PRO"],
    "demo_mode_indicators": ["trial", "demo", "evaluation", "restricted"],
    "wait_after_start": 20
  },
  "timing": {
    "process_check_interval": 0.5,
    "window_check_interval": 1,
    "modal_check_interval": 0.5,
    "window_close_wait": 2
  },
  "debug": {
    "verbose_logging": true,
    "list_all_windows": false
  }
}
